# Firebase web config (client SDK). Dev currently borrows the
# gc-k-usa-business-core-dev project until the brand portal has its own.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Deployment profile: "isolated" (standalone, default for the brand portal)
# or "platform" (embedded in the K Lab suite via the SSO shell).
NEXT_PUBLIC_DEPLOYMENT_PROFILE=isolated
NEXT_PUBLIC_COOKIE_DOMAIN=.klab.localhost
NEXT_PUBLIC_SHELL_ORIGIN=http://app.klab.localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://kbrand.klab.localhost:3005

# Serve seeded in-memory data at the repository seam ("true" to enable).
NEXT_PUBLIC_USE_MOCK_BRAND_API=true

# Server-side Firebase Admin (optional locally; ADC on Cloud Run):
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
