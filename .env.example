# Firebase web config (client SDK). Dev uses the portal's own dedicated
# project (klab-brand-center-dev) — a separate user pool from the SSO fleet.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Microsoft Entra ID (SSO). Directory (tenant) ID — non-secret; routes the
# Microsoft sign-in popup straight to the K Lab login. The single-tenant app
# registration in Entra is what actually enforces the boundary.
NEXT_PUBLIC_ENTRA_TENANT_ID=

# Deployment profile: "isolated" (standalone, default for the brand portal)
# or "platform" (embedded in the K Lab suite via the SSO shell).
NEXT_PUBLIC_DEPLOYMENT_PROFILE=isolated
NEXT_PUBLIC_COOKIE_DOMAIN=.klab.localhost
NEXT_PUBLIC_SHELL_ORIGIN=http://app.klab.localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://kbrand.klab.localhost:3005

# Mock data seam. Default (false/unset) = mock HTTP backend (/api routes over
# a server-side seeded store). "true" = in-browser mock, no server round-trips.
NEXT_PUBLIC_USE_MOCK_BRAND_API=false

# Server-side Firebase Admin. /api/auth/session verifies the Firebase ID token
# (and pins the microsoft.com provider) before minting a session — that
# verification uses Google's PUBLIC certs and works without credentials, so
# none of these are needed for sign-in. Credentials are only required for
# privileged Admin API calls (backfill script, custom claims): paste a
# service-account JSON, or if org policy blocks key creation use
# `gcloud auth application-default login` / ADC on Cloud Run.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
